# Copy to .env for local development. On Replit/Render, set these as secrets.

# --- Required ---
# Dashboard login (the browser asks for these)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Encrypts stored social media tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it changes, saved accounts must be added again.
ENCRYPTION_KEY=

# --- Database ---
# PostgreSQL URL (Replit and Render provide one). Defaults to a local SQLite file.
DATABASE_URL=

# --- AI writer (any OpenAI-compatible API) ---
# OpenRouter (default):
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# Or OpenAI directly:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Posting times ---
# Posts are spread evenly between these times each day, in this timezone.
TIMEZONE=UTC
POSTING_WINDOW_START=07:00
POSTING_WINDOW_END=23:00

# --- Publishing ---
MAX_POST_ATTEMPTS=3
RATE_LIMIT_RETRY_MINUTES=15
# LinkedIn API version (YYYYMM). LinkedIn retires versions about a year after release.
LINKEDIN_API_VERSION=202609

# --- Background jobs ---
# true: the web process also runs the scheduler (simplest, one process).
# false: run `python worker.py` as a separate process.
RUN_SCHEDULER=true
PLAN_INTERVAL_MINUTES=30

PORT=5000

# Social media account keys are NOT set here: add accounts in the dashboard.
